<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DK.EasyRenamer.App</AssemblyName>
    <Version>0.1.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\DK-Easy-Renamer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\\..\\assets\\icons\\DK-Easy-Renamer-256.png" Link="Assets\\DK-Easy-Renamer-256.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <ProjectReference Include="..\DK.EasyRenamer.Core\DK.EasyRenamer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\tools\ux07\Validate-PublicInstaller.ps1"
             Link="Validate-PublicInstaller.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\ux07\Invoke-VerifiedUpdate.ps1"
             Link="Invoke-VerifiedUpdate.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
