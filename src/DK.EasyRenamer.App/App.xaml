<Application x:Class="DK.EasyRenamer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BrandBrush" Color="#2D7BC6" />
            <SolidColorBrush x:Key="BrandHoverBrush" Color="#2266AA" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#F7F9FC" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#DFE6EF" />
            <SolidColorBrush x:Key="TitleBrush" Color="#1F2937" />
            <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#E8F2FC" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#CF4754" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#21866C" />
            <Style x:Key="PrimaryAction" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="SectionHeading" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
