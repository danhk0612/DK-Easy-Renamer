<Window x:Class="DK.EasyRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Easy Renamer"
        Width="1000" Height="700" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FC"
        FontFamily="Segoe UI">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BrandBrush}">
                <TextBlock Text="DK" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="DK Easy Renamer" FontSize="23" FontWeight="SemiBold" Foreground="#1F2937" />
                <TextBlock Text="Windows 11 파일·폴더 일괄 이름 변경 도구" FontSize="12"
                           Foreground="#64748B" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1"
                Background="White" Margin="0,26,0,24" Padding="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="프로젝트 기반 구성 완료" FontSize="25" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="#1F2937" />
                <TextBlock Text="현재는 T00용 기본 화면입니다. 파일 이름 변경이나 탐색기 연동 기능은 아직 구현되지 않았습니다."
                           FontSize="14" Foreground="#475569" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,18,0,0" />
                <Border CornerRadius="8" Background="#E8F2FC" Padding="16" Margin="0,28,0,0">
                    <TextBlock Text="다음 단계: T01 · Windows 11 컨텍스트 메뉴 연동 검증"
                               Foreground="#2266AA" FontWeight="SemiBold" TextAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="DK Easy Renamer · MIT · T00 Foundation"
                   HorizontalAlignment="Right" Foreground="#94A3B8" FontSize="12" />
    </Grid>
</Window>
