<Window x:Class="DK.EasyRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Easy Renamer — T01" Width="1000" Height="700"
        MinWidth="760" MinHeight="500" WindowStartupLocation="CenterScreen"
        Background="#F7F9FC" FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BrandBrush}">
                <TextBlock Text="DK" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="DK Easy Renamer" FontSize="23" FontWeight="SemiBold" Foreground="#1F2937" />
                <TextBlock Text="T01 · 탐색기 선택 항목 전달 검증" Foreground="#64748B" FontSize="12" />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="#E8F2FC" CornerRadius="8" Padding="14" Margin="0,24,0,18">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#2266AA" />
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="16">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Top"
                           FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
                <ListBox x:Name="SelectedPaths" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="3" Text="전달 검증 전용 · 파일 이름을 변경하지 않습니다."
                   Foreground="#94A3B8" Margin="0,12,0,0"
                   HorizontalAlignment="Right" />
    </Grid>
</Window>
