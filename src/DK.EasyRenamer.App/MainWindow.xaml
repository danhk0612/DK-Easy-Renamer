<Window x:Class="DK.EasyRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DK Easy Renamer"
        Loaded="OnShellMenuLoaded"
        SourceInitialized="OnWindowSourceInitialized" Width="1150" Height="750" MinWidth="870" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TitleBrush}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="OnExternalDragOver" Drop="OnExternalDrop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" GlassFrameThickness="0,36,0,0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="True" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BrandBrush}">
            <Grid>
                <Image x:Name="VisibleWindowIcon" Source="/Assets/DK-Easy-Renamer-256.png"
                       AutomationProperties.AutomationId="VisibleWindowIcon"
                       AutomationProperties.Name="DK Easy Renamer 아이콘"
                       Width="22" Height="22" Margin="12,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="VisibleWindowCaption"
                           Text="DK Easy Renamer" AutomationProperties.AutomationId="VisibleWindowCaption"
                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="44,0,160,0" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="23" Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource BrandBrush}">
                <Viewbox Margin="9">
                    <Canvas Width="32" Height="32">
                        <Path Stroke="White" StrokeThickness="2.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                              Data="M5 4 H19 L26 11 V28 H5 Z M19 4 V11 H26 M10 17 H20 M10 22 H17" />
                        <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round"
                              Data="M21 25 L29 17" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="DK Easy Renamer" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleBrush}" />
                <TextBlock Text="파일을 정렬하고, 규칙을 선택해 한 번에 이름을 변경하세요"
                           FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ShellMenuButton" Content="우클릭 메뉴 확인 중" Click="OnToggleShellMenu"
                        IsEnabled="False" Margin="0,0,10,0" ToolTip="탐색기 우클릭 메뉴 등록 상태 확인" />
                <Button x:Name="CheckUpdatesButton" Content="업데이트 확인" Click="OnCheckUpdates"
                        ToolTip="공식 GitHub 정식 릴리스에서 새 버전 확인" Margin="0,0,10,0" />
                <Button Click="OnToggleTheme" ToolTip="라이트 / 다크 테마 전환" Margin="0,0,10,0" MinWidth="40">
                    <ui:SymbolIcon Symbol="WeatherMoon24" />
                </Button>
                <Button Click="OnUndo" x:Name="UndoButton" IsEnabled="False" ToolTip="마지막 변경 실행 취소">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowReset20" Width="19" Height="19" />
                        <TextBlock Text=" 되돌리기" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="355" MinWidth="310" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="13" Padding="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="145" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionHeading}" Text="이름 변경 규칙" />
                    <TextBlock Grid.Row="1" Margin="0,7,0,15"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               Text="규칙을 추가하고 순서를 바꿔 원하는 결과를 만드세요." />
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="RuleChoiceBox" DisplayMemberPath="Label"
                                  MinHeight="34" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Click="OnAddRule" Padding="14,8"
                                Style="{StaticResource PrimaryAction}" ToolTip="규칙 추가">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add20" Width="19" Height="19" />
                                <TextBlock Text=" 추가" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="3" x:Name="RulesList"
                             SelectionChanged="OnSelectedRuleChanged"
                             BorderBrush="{DynamicResource StrokeBrush}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MinHeight="31">
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Checked="OnRuleEnabledChanged" Unchecked="OnRuleEnabledChanged"
                                              VerticalAlignment="Center" Margin="4,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10">
                        <Button Content="↑" Click="OnRuleUp" ToolTip="규칙 순서 위로" Margin="0,0,5,0" MinWidth="35"/>
                        <Button Content="↓" Click="OnRuleDown" ToolTip="규칙 순서 아래로" Margin="0,0,5,0" MinWidth="35"/>
                        <Button Click="OnRemoveRule" ToolTip="선택 규칙 제거">
                            <ui:SymbolIcon Symbol="Delete20" />
                        </Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RuleFields" Margin="2,2,4,4" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="13" Padding="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionHeading}"
                                   Text="파일·폴더 목록" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="OnAddFiles" ToolTip="파일 선택" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentAdd20" Width="19" Height="19" />
                                    <TextBlock Text=" 파일 추가" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddFolderButton" Click="OnShowFolderAddMenu"
                                    ToolTip="추가할 폴더 또는 폴더 안의 항목 범위 선택">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="선택한 폴더 자체 추가" Click="OnAddSelectedFolders" />
                                        <Separator />
                                        <MenuItem Header="폴더 안의 파일 추가 (바로 아래)" Click="OnAddImmediateFolderFiles" />
                                        <MenuItem Header="하위 폴더까지 파일 추가" Click="OnAddRecursiveFolderFiles" />
                                        <Separator />
                                        <MenuItem Header="직속 하위 폴더 자체 추가" Click="OnAddImmediateChildFolders" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderAdd20" Width="19" Height="19" />
                                    <TextBlock Text=" 폴더 추가 ▾" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,15,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="정렬" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" x:Name="SortChoiceBox" DisplayMemberPath="Label"
                                  VerticalContentAlignment="Center" MinHeight="34" />
                        <Button Grid.Column="4" Click="OnSort" ToolTip="오름차순 / 내림차순 정렬">
                            <ui:SymbolIcon Symbol="ArrowSort20" />
                        </Button>
                        <Button Grid.Column="6" Content="↑" Click="OnFileUp" Margin="0,0,5,0"
                                ToolTip="선택 항목 위로" />
                        <Button Grid.Column="7" Content="↓" Click="OnFileDown" Margin="0,0,5,0"
                                ToolTip="선택 항목 아래로" />
                        <Button Grid.Column="8" Click="OnRemoveFiles" ToolTip="목록에서 선택 항목 제거">
                            <ui:SymbolIcon Symbol="Delete20" />
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="FilesGrid" AutoGenerateColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              CanUserSortColumns="False" CanUserAddRows="False"
                              CanUserResizeRows="False" CanUserReorderColumns="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              IsReadOnly="False" RowHeight="39"
                              AlternationCount="2"
                              PreviewMouseLeftButtonDown="OnFilesPointerDown"
                              PreviewMouseMove="OnFilesPointerMove"
                              Drop="OnFilesDrop" DragOver="OnFilesDragOver" AllowDrop="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="변경" Binding="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="55" />
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="42" IsReadOnly="True" />
                            <DataGridTextColumn Header="원본 이름" Binding="{Binding FileName}" Width="1.4*" IsReadOnly="True" />
                            <DataGridTextColumn Header="변경될 이름" Binding="{Binding PreviewName}" Width="1.5*" IsReadOnly="True" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="95" IsReadOnly="True" />
                            <DataGridTextColumn Header="경로" Binding="{Binding ParentPath}" Width="1.5*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Margin="0,11,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               Text="행을 드래그하거나 ↑ ↓ 버튼으로 순서를 변경하세요. 폴더 추가 ▾에서 가져올 대상을 선택할 수 있습니다." />
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TitleBrush}" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ApplyButton"
                    Click="OnApply" Style="{StaticResource PrimaryAction}" IsEnabled="False"
                    ToolTip="미리보기된 이름으로 실제 변경합니다">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Checkmark20" Width="19" Height="19" />
                    <TextBlock Text="  이름 변경 적용" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        </Grid>
    </Grid>
</Window>
